{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Volkner Wartungskatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "updated",
    "status",
    "categories",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "development"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "equipment",
        "title",
        "interval",
        "trigger",
        "source",
        "status",
        "note",
        "updatedAt",
        "instructions",
        "images",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "heizung",
            "aufbau",
            "wasser",
            "elektrik",
            "klima",
            "hydraulik",
            "fahrgestell",
            "ausstattung"
          ]
        },
        "equipment": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "days"
              ],
              "additionalProperties": false,
              "properties": {
                "days": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "months"
              ],
              "additionalProperties": false,
              "properties": {
                "months": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "operatingHours"
              ],
              "additionalProperties": false,
              "properties": {
                "operatingHours": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "distanceKm"
              ],
              "additionalProperties": false,
              "properties": {
                "distanceKm": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "event"
              ],
              "additionalProperties": false,
              "properties": {
                "event": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "source_checked",
            "policy_approved"
          ]
        },
        "note": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date"
        },
        "instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "steps",
            "warnings"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "caption",
              "alt"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^(https://[^\\s]+|assets/[A-Za-z0-9_./-]+)$"
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(https://[^\\s]+|assets/[A-Za-z0-9_./-]+)$"
              },
              "documentNumber": {
                "type": "string",
                "minLength": 1
              },
              "issueDate": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "equipmentId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "information",
            "service",
            "replacement"
          ]
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedBy",
            "restartIntervalFrom"
          ],
          "properties": {
            "allowedBy": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "user",
                  "controller",
                  "volkner_service_online"
                ]
              }
            },
            "event": {
              "type": "string",
              "minLength": 1
            },
            "restartIntervalFrom": {
              "enum": [
                "eventTimestamp",
                "performedAt"
              ]
            },
            "requiresServiceRecord": {
              "type": "boolean"
            },
            "requiresReplacementRecord": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "allowedBy": {
                    "contains": {
                      "const": "controller"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "event"
                ],
                "properties": {
                  "restartIntervalFrom": {
                    "const": "eventTimestamp"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "allowedBy": {
                    "contains": {
                      "const": "volkner_service_online"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "requiresServiceRecord"
                ],
                "properties": {
                  "requiresServiceRecord": {
                    "const": true
                  },
                  "restartIntervalFrom": {
                    "const": "performedAt"
                  }
                }
              }
            }
          ]
        },
        "policyBasis": {
          "enum": [
            "manufacturer",
            "volkner"
          ]
        },
        "intervalStart": {
          "enum": [
            "commissionedAt",
            "componentInstalledAt",
            "systemInstalledAt"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "interval": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source_checked"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "interval": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "webasto-ttp50-betrieb"
              }
            }
          },
          "then": {
            "required": [
              "equipmentId",
              "type",
              "reset"
            ],
            "properties": {
              "equipmentId": {
                "const": "webasto-thermo-top-pro-50-lin"
              },
              "type": {
                "const": "information"
              },
              "reset": {
                "const": {
                  "allowedBy": [
                    "controller"
                  ],
                  "event": "normal_heating_operation_confirmed",
                  "restartIntervalFrom": "eventTimestamp"
                }
              },
              "interval": {
                "const": {
                  "days": 28
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "webasto-ttp50-kontrolle"
              }
            }
          },
          "then": {
            "required": [
              "equipmentId",
              "type",
              "reset"
            ],
            "properties": {
              "equipmentId": {
                "const": "webasto-thermo-top-pro-50-lin"
              },
              "type": {
                "const": "service"
              },
              "reset": {
                "const": {
                  "allowedBy": [
                    "volkner_service_online"
                  ],
                  "restartIntervalFrom": "performedAt",
                  "requiresServiceRecord": true
                }
              },
              "interval": {
                "const": {
                  "months": 84
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "webasto-ttp50-abgasanlage"
              }
            }
          },
          "then": {
            "required": [
              "type",
              "policyBasis",
              "intervalStart",
              "reset"
            ],
            "properties": {
              "type": {
                "const": "service"
              },
              "policyBasis": {
                "const": "volkner"
              },
              "intervalStart": {
                "const": "commissionedAt"
              },
              "interval": {
                "const": {
                  "months": 24
                }
              },
              "reset": {
                "const": {
                  "allowedBy": [
                    "volkner_service_online"
                  ],
                  "restartIntervalFrom": "performedAt",
                  "requiresServiceRecord": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "webasto-ttp50-komplettwechsel"
              }
            }
          },
          "then": {
            "required": [
              "type",
              "policyBasis",
              "intervalStart",
              "reset"
            ],
            "properties": {
              "type": {
                "const": "replacement"
              },
              "policyBasis": {
                "const": "volkner"
              },
              "intervalStart": {
                "const": "systemInstalledAt"
              },
              "interval": {
                "const": {
                  "months": 180
                }
              },
              "reset": {
                "const": {
                  "allowedBy": [
                    "volkner_service_online"
                  ],
                  "restartIntervalFrom": "performedAt",
                  "requiresServiceRecord": true,
                  "requiresReplacementRecord": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "webasto-ttp50-wasserpumpe"
              }
            }
          },
          "then": {
            "required": [
              "type",
              "policyBasis",
              "intervalStart",
              "reset"
            ],
            "properties": {
              "type": {
                "const": "replacement"
              },
              "policyBasis": {
                "const": "volkner"
              },
              "intervalStart": {
                "const": "componentInstalledAt"
              },
              "interval": {
                "const": {
                  "months": 84
                }
              },
              "reset": {
                "const": {
                  "allowedBy": [
                    "volkner_service_online"
                  ],
                  "restartIntervalFrom": "performedAt",
                  "requiresServiceRecord": true,
                  "requiresReplacementRecord": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "webasto-ttp50-dieselpumpe"
              }
            }
          },
          "then": {
            "required": [
              "type",
              "policyBasis",
              "intervalStart",
              "reset"
            ],
            "properties": {
              "type": {
                "const": "replacement"
              },
              "policyBasis": {
                "const": "volkner"
              },
              "intervalStart": {
                "const": "componentInstalledAt"
              },
              "interval": {
                "const": {
                  "months": 84
                }
              },
              "reset": {
                "const": {
                  "allowedBy": [
                    "volkner_service_online"
                  ],
                  "restartIntervalFrom": "performedAt",
                  "requiresServiceRecord": true,
                  "requiresReplacementRecord": true
                }
              }
            }
          }
        }
      ]
    }
  }
}
